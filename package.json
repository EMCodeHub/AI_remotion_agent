{
  "name": "video-ai-edition-remotion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "inspect": "node scripts/inspect-media.mjs",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render": "node scripts/render.mjs MainVideo exports/final/main-video.mp4",
    "render:vertical": "node scripts/render.mjs SocialVertical exports/final/social-vertical.mp4",
    "render:square": "node scripts/render.mjs SocialSquare exports/final/social-square.mp4",
    "render:test": "node scripts/render.mjs MainVideo exports/previews/test.mp4 --frames=0-29",
    "render:obsidian-short": "node scripts/render.mjs ObsidianInstagramShort exports/final/video_obsidian_instagram_short.mp4",
    "render:world-cup-2026": "node scripts/render.mjs WorldCup2026Recap exports/final/world-cup-2026-recap.mp4",
    "render:facebook-mcp": "node scripts/render.mjs FacebookMcpTutorial exports/final/facebook-mcp-tutorial.mp4"
  },
  "dependencies": {
    "@remotion/captions": "4.0.513",
    "@remotion/cli": "4.0.513",
    "@remotion/install-whisper-cpp": "4.0.513",
    "@remotion/media": "4.0.513",
    "@remotion/transitions": "4.0.513",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.513"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "typescript": "^5.9.0"
  }
}
